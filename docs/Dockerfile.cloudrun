# ==============================================================================
# Debt Reality Checker — Standalone Container Image (docs/Dockerfile.cloudrun)
# ==============================================================================
# Build from repository root with:
#   docker build -f docs/Dockerfile.cloudrun -t debt-reality-checker .

FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    PORT=8080 \
    DRC_DB_PATH=/tmp/debt_reality.sqlite

RUN mkdir -p /app/data && chown -R node:node /app

COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/core ./core
COPY --from=build --chown=node:node /app/store ./store
COPY --from=build --chown=node:node /app/bot ./bot
COPY --from=build --chown=node:node /app/cli ./cli
COPY --from=build --chown=node:node /app/tools ./tools
COPY --from=build --chown=node:node /app/examples ./examples
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/server.js ./server.js
COPY --from=build --chown=node:node /app/server.ts ./server.ts

USER node

EXPOSE 8080

CMD ["node", "server.js"]
