{
  "name": "debt-reality-checker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Debt Reality Checker - deterministic, conflict-free household solvency diagnostic (Algorithm v2).",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node server.ts",
    "build": "node tools/build_web.js",
    "start": "node server.ts",
    "web": "vite --config web/vite.config.js",
    "web:build": "node tools/build_web.js",
    "bot": "node --env-file-if-exists=.env bot/index.js",
    "bot:whatsapp": "node --env-file-if-exists=.env bot/index.js --channel baileys",
    "bot:cloud": "node --env-file-if-exists=.env bot/index.js --channel cloud",
    "bot:logout": "node --env-file-if-exists=.env bot/index.js --logout",
    "cli": "node --env-file-if-exists=.env cli/index.js",
    "demo": "node --env-file-if-exists=.env cli/demo.js",
    "audit": "node --env-file-if-exists=.env cli/audit.js",
    "calibrate": "node --env-file-if-exists=.env cli/calibrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/property tests/fixtures",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run web:build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
