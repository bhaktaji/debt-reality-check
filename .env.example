# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 1. Core Application & Privacy Settings
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret used to pseudonymise WhatsApp sender IDs (JIDs / phone numbers)
# into 32-character hex digests before touching SQLite.
PSEUDONYM_SECRET=""

# Automatic inactivity retention window in days (purged at startup and every 6 hours)
DRC_RETENTION_DAYS="90"

# Whether to store free-text expense descriptions on `LOG <amount> <text>`.
DRC_STORE_DESCRIPTIONS="false"

# Bot transport channel (`console`, `cloud`, or `baileys`)
DRC_CHANNEL="cloud"

# ------------------------------------------------------------------------------
# 2. Official WhatsApp Cloud API (Production Transport: `DRC_CHANNEL=cloud`)
# ------------------------------------------------------------------------------
# Numeric Phone Number ID from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=""

# Permanent System User Access Token with `whatsapp_business_messaging` permission
WHATSAPP_ACCESS_TOKEN=""

# Arbitrary secret string configured in Meta Developer Portal -> WhatsApp -> Configuration -> Webhook
WHATSAPP_VERIFY_TOKEN=""

# Meta App Secret from Meta Developer Portal -> App Settings -> Basic
# Used to verify `X-Hub-Signature-256` HMAC-SHA256 signatures on all POST /webhook requests.
WHATSAPP_APP_SECRET=""

# Meta Graph API version (configurable without code changes)
WHATSAPP_GRAPH_API_VERSION="v21.0"
